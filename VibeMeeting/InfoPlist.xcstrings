{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAudioCaptureUsageDescription" : {
      "comment" : "Privacy - Audio Capture Usage Description. macOS shows it when VibeMeeting first asks to hear the call (system audio).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VibeMeeting transcribes the other side of your calls on this Mac. Audio never leaves this Mac and is never saved."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description. macOS shows it when VibeMeeting first asks for the microphone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VibeMeeting transcribes your side of the call on this Mac so replies fit the conversation. Audio never leaves this Mac and is never saved."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
